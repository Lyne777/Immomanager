@*
    Eigenes, einfaches SVG-Stufendiagramm statt MudChart (siehe UtilityBenchmarkChart.razor für die
    gleiche Begründung). Als Stufenkurve statt geglätteter Linie gezeichnet, weil die zugrunde
    liegende Kaltmiete real eine Sprungfunktion ist (sie ändert sich zu konkreten Vertragsdaten, nicht
    kontinuierlich) - siehe KpiCalculationService.BuildRentHistory für die Herleitung aus den
    tatsächlichen Mietverhältnissen. SVG-Koordinaten mit "." als Dezimaltrennzeichen (siehe
    UtilityBenchmarkChart.razor).
*@
@if (Points.Count < 2 || (Points[^1].Date.DayNumber - Points[0].Date.DayNumber) <= 0)
{
    <MudAlert Severity="Severity.Info">Noch nicht genug Daten (Kaufdatum/Mietverhältnisse), um eine Entwicklung darzustellen.</MudAlert>
}
else
{
    <svg viewBox="@($"0 0 {SvgWidth} {SvgHeight}")" style="width:100%; height:auto; max-height:220px;">
        <line x1="@Inv(LeftMargin)" y1="@Inv(BaselineY)" x2="@Inv(LeftMargin + ChartWidth)" y2="@Inv(BaselineY)"
              stroke="var(--mud-palette-lines-default)" stroke-width="1" />

        <polygon points="@AreaPoints" fill="var(--mud-palette-primary)" opacity="0.12" />
        <polyline points="@StepPoints" fill="none" stroke="var(--mud-palette-primary)" stroke-width="2.5" />

        @for (var i = 0; i < Points.Count; i++)
        {
            var point = Points[i];
            <circle cx="@Inv(XFor(point.Date))" cy="@Inv(YFor(point.Value))" r="@(i == 0 || i == Points.Count - 1 ? 5 : 3.5)" fill="var(--mud-palette-primary)">
                <title>@point.Date.ToString("dd.MM.yyyy"): @FormatCurrency(point.Value)</title>
            </circle>
        }

        <text x="@Inv(XFor(Points[0].Date))" y="@Inv(YFor(Points[0].Value) - 12)" text-anchor="start" font-size="12" font-weight="600" fill="var(--mud-palette-text-primary)">
            @FormatCurrency(Points[0].Value)
        </text>
        <text x="@Inv(XFor(Points[0].Date))" y="@Inv(BaselineY + 20)" text-anchor="start" font-size="11" fill="var(--mud-palette-text-secondary)">
            @Points[0].Date.ToString("MM/yyyy") (Kauf)
        </text>

        <text x="@Inv(XFor(Points[^1].Date))" y="@Inv(YFor(Points[^1].Value) - 12)" text-anchor="end" font-size="12" font-weight="600" fill="var(--mud-palette-text-primary)">
            @FormatCurrency(Points[^1].Value)
        </text>
        <text x="@Inv(XFor(Points[^1].Date))" y="@Inv(BaselineY + 20)" text-anchor="end" font-size="11" fill="var(--mud-palette-text-secondary)">
            heute
        </text>
    </svg>

    <MudText Typo="Typo.body2" Class="mt-2" Color="@(Points[^1].Value >= Points[0].Value ? Color.Success : Color.Error)">
        @(Points[^1].Value - Points[0].Value >= 0 ? "+" : "")@FormatCurrency(Points[^1].Value - Points[0].Value) (@ChangePercent.ToString("+0.0;-0.0;0.0") %) seit Kauf
    </MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        @(Points.Count - 2) Mietänderung@(Points.Count - 2 == 1 ? "" : "en") anhand der hinterlegten Mietverhältnisse erkannt
        (Punkte antippen/hovern für Details je Zeitpunkt).
    </MudText>
}

@code {
    [Parameter, EditorRequired] public List<(DateOnly Date, decimal Value)> Points { get; set; } = new();

    private const int SvgWidth = 700;
    private const int SvgHeight = 180;
    private const int LeftMargin = 90;
    private const int RightMargin = 90;
    private const int TopMargin = 24;
    private const int BottomMargin = 40;
    private int ChartWidth => SvgWidth - LeftMargin - RightMargin;
    private int ChartHeight => SvgHeight - TopMargin - BottomMargin;

    private decimal MaxValue => Math.Max(Points.Count > 0 ? Points.Max(p => p.Value) : 0, 1) * 1.15m;
    private int TotalDays => Math.Max(1, Points[^1].Date.DayNumber - Points[0].Date.DayNumber);

    private double BaselineY => TopMargin + ChartHeight;

    private double XFor(DateOnly date) =>
        LeftMargin + (double)(date.DayNumber - Points[0].Date.DayNumber) / TotalDays * ChartWidth;

    private double YFor(decimal value) =>
        MaxValue > 0 ? TopMargin + ChartHeight - (double)(value / MaxValue) * ChartHeight : BaselineY;

    private string StepPoints
    {
        get
        {
            var parts = new List<string> { $"{Inv(XFor(Points[0].Date))},{Inv(YFor(Points[0].Value))}" };
            for (var i = 1; i < Points.Count; i++)
            {
                var x = XFor(Points[i].Date);
                parts.Add($"{Inv(x)},{Inv(YFor(Points[i - 1].Value))}");
                parts.Add($"{Inv(x)},{Inv(YFor(Points[i].Value))}");
            }
            return string.Join(" ", parts);
        }
    }

    private string AreaPoints =>
        $"{Inv(XFor(Points[0].Date))},{Inv(BaselineY)} {StepPoints} {Inv(XFor(Points[^1].Date))},{Inv(BaselineY)}";

    private decimal ChangePercent => Points[0].Value > 0 ? (Points[^1].Value - Points[0].Value) / Points[0].Value * 100 : 0;

    private static string Inv(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatCurrency(decimal value) => value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("de-DE"));
}
