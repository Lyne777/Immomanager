@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Medium" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudIcon Icon="@Icons.Material.Filled.Apartment" Class="ms-2 me-2" />
        <MudText Typo="Typo.h6">Immomanager</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mud-text-secondary d-none d-md-block">Immobilien-Asset-Management</MudText>
    </MudAppBar>

    @* DrawerVariant.Responsive statt Mini: unterhalb des Breakpoints (Standard Md) verhält sich die
       Schublade wie "Temporary" (überlagert den Inhalt vollständig, per Hamburger auf-/zuklappbar) -
       auf einem 375px breiten Handy-Bildschirm nimmt sie so keine dauerhafte Icon-Leisten-Breite weg.
       Bewusst KEIN eigenes Umschalten zwischen Mini/Temporary per JS-Breakpoint-Erkennung zur
       Laufzeit (erste Version) - das führte zu einer Schublade, die trotz "offen" an ihrer
       geschlossenen CSS-Position hängen blieb, weil MudBlazor beim Varianten-Wechsel offenbar eine
       globale Zustands-CSS-Klasse auf dem Layout nicht sauber zurücksetzt. "Responsive" ist die von
       MudBlazor selbst dafür vorgesehene, fertig getestete Variante ohne dieses Risiko. *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="DrawerVariant.Responsive">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="px-4" Style="padding-top: 80px;">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>

    <ArminAssetChat />
</MudLayout>

<div id="blazor-error-ui">
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="" class="reload">Neu laden</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1565C0",
            Secondary = "#2E7D32",
            AppbarBackground = "#1565C0",
            Background = "#F4F6F8",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#42A5F5",
            Secondary = "#66BB6A",
        },
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
