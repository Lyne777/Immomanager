@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" MaxWidth="MaxWidth.Medium" />
<MudSnackbarProvider />

<MudAppBar Elevation="1" Fixed="true">
    <MudIcon Icon="@Icons.Material.Filled.Restaurant" Class="me-2" />
    <MudText Typo="Typo.h6">Küche</MudText>
</MudAppBar>

<div style="padding-top:64px; padding-bottom:76px; min-height:100vh;">
    @Body
</div>

<MudPaper Elevation="4" Square="true" Style="position:fixed; bottom:0; left:0; right:0; z-index:1300;">
    <MudStack Row="true" Justify="Justify.SpaceEvenly" Class="py-1">
        <MudButton StartIcon="@Icons.Material.Filled.ViewList" Href="kueche" Color="@ColorFor("kueche")" Class="flex-column" Style="min-width:0;">
            Pläne
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.AddCircle" Href="kueche/neu" Color="@ColorFor("kueche/neu")" Class="flex-column" Style="min-width:0;">
            Neu
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Settings" Href="kueche/einstellungen" Color="@ColorFor("kueche/einstellungen")" Class="flex-column" Style="min-width:0;">
            Bring!
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2E7D32",
            AppbarBackground = "#2E7D32",
            Background = "#F4F6F8",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#66BB6A",
        },
    };

    private Color ColorFor(string relativePath)
    {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).TrimEnd('/');
        return current.Equals(relativePath, StringComparison.OrdinalIgnoreCase) ? Color.Primary : Color.Default;
    }
}
