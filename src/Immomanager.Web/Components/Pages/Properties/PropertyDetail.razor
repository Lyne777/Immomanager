    private async Task OnFilesSelectedAsync(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        _uploading = true;
        StateHasChanged();

        foreach (var file in files)
        {
            try
            {
                await ImageService.UploadAsync(Id, file);
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogWarning(ex, "Foto-Upload für PropertyId {PropertyId}, Datei {FileName} abgelehnt.", Id, file.Name);
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }

        _uploading = false;
        await LoadAsync();
    }

