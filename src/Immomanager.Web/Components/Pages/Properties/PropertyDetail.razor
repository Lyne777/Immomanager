    private async Task OnUtilityPdfsSelectedAsync(int year, IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count == 0)
        {
            return;
        }

        var uploadedCount = 0;
        foreach (var file in files)
        {
            try
            {
                await UtilityService.UploadStatementPdfAsync(Id, year, file);
                uploadedCount++;
            }
            catch (InvalidOperationException ex)
            {
                Logger.LogWarning(ex, "Nebenkosten-PDF-Upload für PropertyId {PropertyId}, Jahr {Year} abgelehnt.", Id, year);
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }

        if (uploadedCount > 0)
        {
            Snackbar.Add(uploadedCount == 1 ? "Abrechnungs-PDF hochgeladen." : $"{uploadedCount} Abrechnungs-PDFs hochgeladen.", Severity.Success);
        }

        await LoadAsync();
    }

