<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit" id="repaymentVehicleForm">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_model.FinancingId" Label="Gekoppeltes Darlehen" Required="true">
                        @foreach (var financing in Financings)
                        {
                            <MudSelectItem Value="financing.Id">@financing.BankName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_model.ProductName" Label="Produkt/Anbieter" Required="true"
                                  HelperText="z. B. &quot;Ankommer 6 (Bausparvertrag)&quot;" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_model.TargetAmount" Label="Zielbetrag €" Min="0" Format="N2" Adornment="Adornment.End" AdornmentText="€" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_model.MonthlyContribution" Label="Monatsbeitrag €" Min="0" Format="N2" Adornment="Adornment.End" AdornmentText="€" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudNumericField @bind-Value="_model.CurrentValue" Label="Aktueller Sparstand €" Format="N2" Adornment="Adornment.End" AdornmentText="€" />
                </MudItem>
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Calculate" OnClick="CalculateSavingsValue">
                        Sparstand berechnen
                    </MudButton>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_model.CalculationStartValue" Label="Sparstand am Stichtag €" Format="N2" Adornment="Adornment.End" AdornmentText="€"
                                      HelperText="Kann negativ sein, z. B. bei einer Abschlussgebühr zu Vertragsbeginn" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_calculationStartDate" Label="Stichtag (i. d. R. Vertrags-/Beitragsbeginn)" Editable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_contractEndDate" Label="Vertragsende" Editable="true" />
                </MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mt-2 d-block mud-text-secondary">
                "Sparstand berechnen" schreibt den Stand am Stichtag mit dem Monatsbeitrag linear bis heute
                fort (ohne Bausparzins/Bewertungszahl-Mechanik) und füllt das Feld nur als Vorschlag - es
                bleibt frei überschreibbar.
            </MudText>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="repaymentVehicleForm">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public List<Financing> Financings { get; set; } = new();
    [Parameter] public RepaymentVehicle? Existing { get; set; }

    private RepaymentVehicle _model = new();
    private DateTime? _contractEndDate;
    private DateTime? _calculationStartDate;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _model = new RepaymentVehicle
            {
                Id = Existing.Id,
                FinancingId = Existing.FinancingId,
                ProductName = Existing.ProductName,
                TargetAmount = Existing.TargetAmount,
                MonthlyContribution = Existing.MonthlyContribution,
                CurrentValue = Existing.CurrentValue,
                CalculationStartDate = Existing.CalculationStartDate,
                CalculationStartValue = Existing.CalculationStartValue,
                ContractEndDate = Existing.ContractEndDate,
            };
            _contractEndDate = Existing.ContractEndDate.ToDateTime(TimeOnly.MinValue);
            _calculationStartDate = Existing.CalculationStartDate.ToDateTime(TimeOnly.MinValue);
        }
        else
        {
            _model.FinancingId = Financings.FirstOrDefault()?.Id ?? 0;
            _contractEndDate = DateTime.Today.AddYears(10);
            _calculationStartDate = DateTime.Today;
        }
    }

    private void Submit()
    {
        _model.ContractEndDate = DateOnly.FromDateTime(_contractEndDate ?? DateTime.Today);
        _model.CalculationStartDate = DateOnly.FromDateTime(_calculationStartDate ?? DateTime.Today);
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void CalculateSavingsValue()
    {
        _model.CalculationStartDate = DateOnly.FromDateTime(_calculationStartDate ?? DateTime.Today);
        _model.CurrentValue = LoanAmortizationCalculator.ProjectSavingsValue(_model, DateOnly.FromDateTime(DateTime.Today));
    }

    private void Cancel() => MudDialog.Cancel();
}
