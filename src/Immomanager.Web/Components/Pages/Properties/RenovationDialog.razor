<MudDialog>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit" id="renovationForm">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Name" Label="Bezeichnung" Required="true" For="@(() => _model.Name)"
                                  HelperText="z. B. &quot;Bad-Modernisierung OG&quot;" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="RenovationCategory" @bind-Value="_model.Category" Label="Kategorie">
                        @foreach (var category in Enum.GetValues<RenovationCategory>())
                        {
                            <MudSelectItem Value="@category">@RenovationAnalyticsService.CategoryDisplayNames[category]</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="RenovationStatus" @bind-Value="_model.Status" Label="Status">
                        @foreach (var status in Enum.GetValues<RenovationStatus>())
                        {
                            <MudSelectItem Value="@status">@RenovationAnalyticsService.StatusDisplayNames[status]</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_startDate" Label="Start" Editable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_endDate" Label="Ende (optional)" Editable="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField @bind-Value="_model.AreaSqm" Label="Betroffene Fläche (m²)" Min="0" Format="N2" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_model.PlannedTotalCost" Label="Gesamtkosten geplant €" Min="0" Format="N2" Adornment="Adornment.End" AdornmentText="€" />
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center">
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Ist-Kosten ergeben sich automatisch aus den Gewerk-Positionen des Projekts.
                    </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Notes" Label="Notizen" Lines="2" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="renovationForm">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public int PropertyId { get; set; }
    [Parameter] public RenovationProject? Existing { get; set; }

    private RenovationProject _model = new();
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate;

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            _model = new RenovationProject
            {
                Id = Existing.Id,
                PropertyId = Existing.PropertyId,
                Name = Existing.Name,
                Category = Existing.Category,
                Status = Existing.Status,
                StartDate = Existing.StartDate,
                EndDate = Existing.EndDate,
                AreaSqm = Existing.AreaSqm,
                PlannedTotalCost = Existing.PlannedTotalCost,
                Notes = Existing.Notes,
            };
            _startDate = Existing.StartDate.ToDateTime(TimeOnly.MinValue);
            _endDate = Existing.EndDate?.ToDateTime(TimeOnly.MinValue);
        }
        else
        {
            _model.PropertyId = PropertyId;
        }
    }

    private void Submit()
    {
        _model.StartDate = DateOnly.FromDateTime(_startDate ?? DateTime.Today);
        _model.EndDate = _endDate.HasValue ? DateOnly.FromDateTime(_endDate.Value) : null;
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
